{
  "name": "toodool",
  "version": "1.1.0",
  "description": "A minimalistic todo list application built with vanilla JavaScript",
  "main": "./src/index.js",
  "author": "Agx <sudo.ax1g@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ax1g/Toodool.git"
  },
  "bugs": {
    "url": "https://github.com/ax1g/Toodool/issues"
  },
  "homepage": "https://ax1g.github.io/Toodool/",
  "keywords": [
    "todo",
    "todo-list",
    "vanilla-javascript",
    "webpack",
    "localstorage",
    "task-manager"
  ],
  "scripts": {
    "start": "webpack serve --config webpack.config.js --open",
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "clean-webpack-plugin": "^4.0.0",
    "eslint": "^9.9.1",
    "eslint-plugin-node": "^11.1.0",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "html-webpack-plugin": "^5.6.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "css-loader": "^7.1.2",
    "date-fns": "^3.6.0",
    "mini-css-extract-plugin": "^2.9.1",
    "style-loader": "^4.0.0"
  }
}
